{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Profile (data/profile/base-profile.yaml)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "linkedin": {
      "type": "string",
      "description": "LinkedIn handle or full URL."
    },
    "github": {
      "type": "string",
      "description": "GitHub username or full URL."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Professional summary shown in the Profile section."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "string"
          }
        },
        "required": [
          "language"
        ]
      }
    }
  },
  "required": [
    "name",
    "summary"
  ]
}
