{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Experience (data/experience/experience.yaml)",
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional unique id that bullets can reference with job."
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": [
            "string",
            "integer"
          ]
        },
        "end": {
          "type": [
            "string",
            "integer"
          ]
        },
        "location": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "bullets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Static bullets, shown when no bullet-bank bullet is selected for this job."
        }
      },
      "required": [
        "role",
        "company"
      ]
    }
  },
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/entry"
      }
    },
    {
      "$ref": "#/definitions/entry"
    }
  ]
}
